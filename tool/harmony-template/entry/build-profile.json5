{
  "apiType": "stageMode",
  "buildOption": {
    // RNOH 的 C++ 部分（librnoh_app.so）—— 把 RN 的 native 侧编进 HAP
    "externalNativeOptions": {
      "path": "./src/main/cpp/CMakeLists.txt",
      "arguments": "",
      "cppFlags": "-fstack-protector-strong -Wl,-z,noexecstack",
      // 必须同时出 x86_64：DevEco 的模拟器（Mate 80 Pro Max 等）是 x86_64 镜像，
      // 只编 arm64-v8a 时装上去会秒退，hilog 里是
      //   F RNOH_ARK: Couldn't create bindings between ETS and CPP. libRNOHApp is undefined.
      // （.so 在 HAP 里根本没有这个 ABI，加载不到）。真机是 arm64-v8a。
      "abiFilters": ["arm64-v8a", "x86_64"],
    },
  },
  "targets": [
    {
      "name": "default",
      "runtimeOS": "HarmonyOS",
    },
  ],
}
