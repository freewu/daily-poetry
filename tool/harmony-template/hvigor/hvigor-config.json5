// hvigor 自己的配置。modelVersion 跟 DevEco 大版本走（5.x → 5.0.0，6.x → 6.0.0），
// tool/harmony.sh 会按本机 SDK 填。改完 DevEco 里 Sync 一次。
{
  "modelVersion": "__HVIGOR_MODEL_VERSION__",
  "dependencies": {},
  "execution": {
    // "daemon": true,        /* 常驻进程，增量构建快；CI 里可以关掉 */
    // "incremental": true,
  },
  "logging": {},
  "debugging": {},
  "nodeOptions": {
    // 全量构建 + NDK 编译吃内存，给 4G
    "maxOldSpaceSize": 4096,
  },
}
